{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "nodenext",
    "rootDir": "../",
    "rootDirs": [
      "./src",
      "../shared"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
